# Copy this file to .env at the repository root and fill in local values.
# Keep DATABASE_URL consistent with the POSTGRES_* values below.
# URL-encode special characters in the database username and password.
DATABASE_URL=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# Generate a private value: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

OLLAMA_BASE_URL=http://localhost:11434
PORT=3005

# ---------------------------------------------------------------------------
# 生产部署（docker/docker-compose.deploy.yml，镜像分发模式）取值与本地不同：
#   DATABASE_URL 的主机名用 compose 网络内服务名：postgresql://USER:PASSWORD@miaomiao-aiflow-postgresql:5432/DATABASE
#   OLLAMA_BASE_URL 用 http://host.docker.internal:11434（容器通过 extra_hosts 访问宿主机 Ollama）
#   应用镜像由 CD 构建推送，APP_IMAGE 由流水线注入，无需写进 .env
# 服务器只需要 Docker；.env 提前放好一次，之后不用再动。不要提交到仓库。
# ---------------------------------------------------------------------------
